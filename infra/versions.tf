terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.4"
    }
  }
}

# The provider has no hard-coded endpoint: AWS_ENDPOINT_URL, AWS_CA_BUNDLE and
# the shared credentials/config files decide where it talks to. In CI they
# point at AWS Emulator; unset them and the same code targets real AWS.
provider "aws" {
  region = var.region

  default_tags {
    tags = {
      Project   = var.project
      ManagedBy = "terraform"
    }
  }
}
